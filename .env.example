# ========================================================
# DIMPLE'S WORLD - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# Duplicate this file to .env and insert your real credentials.
# NEVER commit your actual .env file with production secrets.

PORT=5000
NODE_ENV=development

# 1. MongoDB Database Connection
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/dimples_world?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster.mongodb.net/dimples_world?retryWrites=true&w=majority

# 2. Google Gemini AI API Key
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# 3. ImageKit Media Storage Credentials
# Obtain from: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=YOUR_IMAGEKIT_PUBLIC_KEY
IMAGEKIT_PRIVATE_KEY=YOUR_IMAGEKIT_PRIVATE_KEY
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID

# 4. Admin Dashboard Security
ADMIN_EMAIL=dimple@dimplesworld.com
ADMIN_PASSWORD=sakura2026
SESSION_SECRET=dimple-super-secret-sakura-key-2026-production
